{
  "name": "@michaelhelvey/node-ts-starter",
  "version": "1.0.0",
  "description": "nodejs starter project",
  "license": "MIT",
  "author": {
    "name": "Michael Helvey",
    "email": "michael.helvey1@gmail.com",
    "url": "https://github.com/michaelhelvey"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelhelvey/node-ts-starter"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json",
    "tsconfig.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "vp config",
    "dev": "tsx --watch ./src/index.ts",
    "test": "vp test",
    "lint": "vp lint --fix",
    "fmt": "vp fmt",
    "build": "vp pack",
    "validate": "vp fmt && vp lint --fix && vp pack && vp test"
  },
  "devDependencies": {
    "@michaelhelvey/vite-config": "2.0.6",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.4.0+sha512.37536c26ed40ab4134b6511e09f6b27f3ebb45687468f2406ca3805279a4e5ca158c1931350ad9774d6ab2108d71b3dbaeb39943159294375e4d053e8e05685c"
}
